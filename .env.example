# ==== Database ====
# Local development uses SQLite (schema.prisma provider = "sqlite") since no
# MySQL server is required to run the app locally.
DATABASE_URL="file:./dev.db"
# Production on Hostinger: change schema.prisma `provider` to "mysql" and use
# the free MySQL database from hPanel (see DEPLOY.md), e.g.:
# DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/marry_wedding"

# ==== Session / Auth ====
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-32-plus-random-bytes"

# ==== SMTP (Nodemailer) ====
# Gmail: use an App Password (not your normal Gmail password) — https://myaccount.google.com/apppasswords
# Hostinger SMTP: host mail.hostinger.com, port 465 (SSL) or 587 (TLS)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="marrywedding95@gmail.com"
SMTP_PASS="replace-with-app-password"
MAIL_FROM="MARRY WEDDING Website <marrywedding95@gmail.com>"
MAIL_TO="marrywedding95@gmail.com"

# ==== Site ====
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# ==== Uploads ====
UPLOAD_MAX_SIZE_MB="5"

# ==== Admin seed (used only by `npm run db:seed`, never read at runtime) ====
ADMIN_SEED_EMAIL="admin@marrywedding.vn"
ADMIN_SEED_PASSWORD="replace-with-a-strong-password"
