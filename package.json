{
  "name": "marry-wedding",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/clean-next-cache.mjs && prisma db push --skip-generate",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.13.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "jose": "^5.9.6",
    "marked": "^12.0.2",
    "next": "15.5.29",
    "nodemailer": "^10.5.0",
    "postcss": "^8.5.32",
    "prisma": "^5.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.13.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "minimatch": "^11.0.8",
    "postcss-selector-parser": "^7.2.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
